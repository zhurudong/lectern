{
  "name": "lectern-extension",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Lectern \u2014 a read-only local code reader with configurable file URL opening (Chrome MV3 extension)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhurudong/lectern.git"
  },
  "homepage": "https://github.com/zhurudong/lectern",
  "scripts": {
    "dev": "vite build --watch",
    "check": "node scripts/check-invariants.mjs && node scripts/check-language-coverage.mjs && node --test scripts/check-language-coverage.test.mjs && node scripts/check-repository.mjs && node scripts/check-role-vocabulary.mjs && npm run check:local-files && npm run check:sql && npm run check:git && npm run check:i18n",
    "check:local-files": "node scripts/check-local-files.mjs",
    "test:local-files": "node scripts/e2e-local-files.mjs",
    "check:sql": "node scripts/check-sql-outline.mjs",
    "check:git": "npm run check:git-fixture && npm run check:git-access && npm run check:git-loose && npm run check:git-pack && npm run check:git-refs && npm run check:git-graph && npm run check:git-worktree && npm run check:git-service && npm run check:git-ui-contracts",
    "check:git-fixture": "node scripts/check-git-fixture.mjs",
    "check:git-access": "node scripts/check-git-access.mjs",
    "check:git-loose": "node scripts/check-git-loose.mjs",
    "check:git-pack": "node scripts/check-git-pack.mjs",
    "check:git-refs": "node scripts/check-git-refs.mjs",
    "check:git-graph": "node scripts/check-git-graph.mjs",
    "check:git-worktree": "node scripts/check-git-worktree.mjs",
    "check:git-service": "node scripts/check-git-service.mjs",
    "check:git-ui-contracts": "node scripts/check-git-ui-contracts.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:ai": "tsc --noEmit && vite build --mode ai",
    "check:ai": "npm run build:ai && AI_TERMINAL=1 DIST=dist-ai node scripts/check-invariants.mjs && npm run check:ai-negative && npm --prefix lectern-agent test && node scripts/e2e-ai.mjs",
    "check:ai-negative": "node scripts/check-ai-negative.mjs",
    "setup:ai": "npm run build:ai && node scripts/native/register-dev.mjs",
    "package:companion": "node scripts/native/build.mjs",
    "check:i18n": "node scripts/check-i18n-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepare:store": "node scripts/prepare-store-kit.mjs",
    "prepare:store-test": "node scripts/prepare-store-test.mjs",
    "check:store-identity": "node scripts/e2e-store-identity.mjs",
    "test:store-manual": "node scripts/manual-store-test.mjs",
    "shots:store": "node scripts/shot-release-kit.mjs",
    "build:public-pages": "node scripts/build-public-pages.mjs",
    "prepare:agent-release": "node scripts/native/prepare-github.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.7.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.2",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@lezer/common": "^1.2.1",
    "@lezer/cpp": "^1.1.6",
    "@lezer/go": "^1.0.1",
    "@lezer/highlight": "^1.2.0",
    "@lezer/java": "^1.1.3",
    "@lezer/javascript": "^1.5.4",
    "@lezer/php": "^1.0.6",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.2",
    "@preact/signals": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.1.5",
    "ignore": "^7.0.8",
    "markdown-it": "^14.1.0",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@types/chrome": "^0.0.268",
    "@types/markdown-it": "^14.1.1",
    "puppeteer-core": "^25.7.0",
    "typescript": "^5.4.5",
    "vite": "^6.4.3"
  }
}
